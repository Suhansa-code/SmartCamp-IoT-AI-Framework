# ── EMQX broker (same one the Pi publishes to) ──────────────────────────────
EMQX_HOST=sa60a43c.ala.asia-southeast1.emqxsl.com
EMQX_PORT=8883
EMQX_USERNAME=admin
EMQX_PASSWORD=admin@123

# ── Frontend → backend URL ──────────────────────────────────────────────────
# LEAVE THIS EMPTY for any compose deployment, local or VM.
#
# nginx serves the UI and /api/ on one origin, and the frontend defaults to a
# relative /api/... — correct on localhost, on the VM, and after the VM's
# public IP changes. NEXT_PUBLIC_* is baked into the bundle at BUILD time, so
# putting an address here pins the image to that address and it goes stale the
# moment the host moves.
#
# Set it only for `next dev` on :3000 with no nginx: http://localhost:3001
NEXT_PUBLIC_API_URL=

# ── Port bindings ────────────────────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ── Simulation (disable in production — real data comes from the Pi) ─────────
ENABLE_SIMULATION=false
