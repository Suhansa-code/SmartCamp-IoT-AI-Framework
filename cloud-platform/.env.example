# ── EMQX broker (same one the Pi publishes to) ──────────────────────────────
EMQX_HOST=i17140d1.ala.asia-southeast1.emqxsl.com
EMQX_PORT=8883
EMQX_USERNAME=admin
EMQX_PASSWORD=public

# ── Frontend → backend URL (must be reachable FROM the browser) ─────────────
# Local dev:  http://localhost:3001
# VM deploy:  http://<VM_PUBLIC_IP>:3001  or  https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Port bindings ────────────────────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ── Simulation (disable in production — real data comes from the Pi) ─────────
ENABLE_SIMULATION=false
