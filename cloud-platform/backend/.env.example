# =============================================
# SmartCamp Cloud Backend — environment
# Copy to .env and fill in your values.
# =============================================

# ── HTTP server ──────────────────────────────────────────────────────────────
PORT=3001

# ── PostgreSQL (AWS VM) ───────────────────────────────────────────────────────
# Set DB_ENABLED=true to use PostgreSQL instead of the in-memory repository.
# Point the connection values at the PostgreSQL instance on your AWS VM.
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcamp
DB_USER=postgres
DB_PASSWORD=change-me
# Enable SSL when connecting over the public internet (recommended for AWS).
DB_SSL=false
# Optional — overrides the individual DB_* values above.
# DATABASE_URL=postgres://postgres:password@db-host:5432/smartcamp

# ── Network monitoring ────────────────────────────────────────────────────────
# true → run simulation (no MQTT broker needed); false → connect to real broker
ENABLE_SIMULATION=true
USE_REAL_NETWORK=true
PING_TARGET=8.8.8.8

# ── MQTT broker (network domain) ─────────────────────────────────────────────
# Used by the NetworkMonitor when ENABLE_SIMULATION=false
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── EMQX broker (resources domain) ───────────────────────────────────────────
# Same broker the Pi publishes to. CampDataService subscribes here for camp events.
EMQX_HOST=i17140d1.ala.asia-southeast1.emqxsl.com
EMQX_PORT=8883
EMQX_USERNAME=admin
EMQX_PASSWORD=public
# Optional CA certificate for TLS (leave empty to disable verification)
EMQX_CA_CERT=

# ── Disaster domain — flood prediction & water level ─────────────────────────
# Paths to the Python flood model + interpreter. Leave empty to use defaults
# (edge-gateway .venv + edge-gateway XGBoost model).
DISASTER_PYTHON_EXECUTABLE=
DISASTER_FLOOD_MODEL_SCRIPT=
DISASTER_EDGE_GATEWAY_BASE_URL=http://localhost:5000
DISASTER_EDGE_WATER_LEVEL_HISTORY_PATH=/gauging-station-water-level-history

# ── Education domain — alert database ────────────────────────────────────────
# SQLite file used for synced PAGES alerts. Override in tests to use a temp DB.
ALERTS_DB_PATH=./data/alerts.db

# ── Resources domain — live camp data (Postgres) ─────────────────────────────
# Persists persons/distributions received from campData.service.js so they
# survive a restart, instead of living only in the in-memory store.
PGHOST=localhost
PGPORT=5432
PGDATABASE=smartcamp
PGUSER=smartcamp_app
PGPASSWORD=
