# =============================================
# SmartCamp Cloud Backend — environment
# Copy to .env and fill in your values.
# =============================================

# ── HTTP server ──────────────────────────────────────────────────────────────
PORT=3001

# Public donation portal. Use an HTTPS domain in production and generate a
# random session secret of at least 32 bytes.
PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
DONATION_SESSION_SECRET=change-me-to-a-long-random-value
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Relief portal (donations → purchases → delivery) ─────────────────────────
# Provider adapters run in 'sandbox' until partner agreements and API
# credentials are signed. In sandbox mode PayHere/Uber/PickMe calls are served
# by local mock adapters and no real money moves.
RELIEF_PROVIDER_MODE=sandbox
# HMAC secret used by the sandbox payment callback (dev/demo only).
RELIEF_SANDBOX_WEBHOOK_SECRET=relief-sandbox-secret

# PayHere (Sri Lankan gateway — supports Visa/Mastercard, eZ Cash, etc.).
# Obtain merchant_id + merchant_secret from https://merchant.payhere.lk after
# KYC. With these unset, payments fall back to the sandbox adapter.
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
PAYHERE_MODE=sandbox
PAYHERE_BASE_URL=https://sandbox.payhere.lk
PAYHERE_NOTIFY_URL=          # e.g. https://your-domain/api/relief/webhooks/payhere
PAYHERE_RETURN_URL=          # e.g. https://your-domain/relief/checkout/result
PAYHERE_CANCEL_URL=

# Uber Delivery API (developer.uber.com). Server token required for live
# quotes/booking; unset → manual booking fallback only.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_SERVER_TOKEN=
UBER_BASE_URL=https://api.uber.com/v1
UBER_SANDBOX=true

# PickMe (pickme.lk merchant API — commercial agreement required).
PICKME_API_KEY=
PICKME_MERCHANT_ID=
PICKME_BASE_URL=https://admin.pickme.lk/api


# ── PostgreSQL (AWS VM) ───────────────────────────────────────────────────────
# Set DB_ENABLED=true to use PostgreSQL instead of the in-memory repository.
# Point the connection values at the PostgreSQL instance on your AWS VM.
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcamp
DB_USER=postgres
DB_PASSWORD=change-me
# Enable SSL when connecting over the public internet (recommended for AWS).
DB_SSL=false
# Optional — overrides the individual DB_* values above.
# DATABASE_URL=postgres://postgres:password@db-host:5432/smartcamp

# Per-address TCP handshake budget, ms. Node's own default is 250ms, which a
# managed database in a distant region cannot meet: every address it resolves
# to is abandoned mid-handshake and the pool reports `connect ETIMEDOUT` on all
# of them, which looks like a blocked port but is not. Raise this (not the
# credentials) when the backend cannot reach a remote database from a
# workstation far from the region.
DB_CONNECT_ATTEMPT_TIMEOUT_MS=5000
# Budget for connect + TLS + SCRAM before the pool gives up, ms. A high-RTT
# link spends several round trips in the handshake alone.
DB_CONNECTION_TIMEOUT_MS=15000

# ── Network monitoring ────────────────────────────────────────────────────────
# true → run simulation (no MQTT broker needed); false → connect to real broker
ENABLE_SIMULATION=true
USE_REAL_NETWORK=true
PING_TARGET=8.8.8.8

# ── MQTT broker (network domain) ─────────────────────────────────────────────
# Used by the NetworkMonitor when ENABLE_SIMULATION=false
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── EMQX broker (resources domain) ───────────────────────────────────────────
# Same broker the Pi publishes to. CampDataService subscribes here for camp events.
EMQX_HOST=sa60a43c.ala.asia-southeast1.emqxsl.com
EMQX_PORT=8883
EMQX_USERNAME=admin
EMQX_PASSWORD=admin@123
# Optional CA certificate for TLS (leave empty to disable verification)
EMQX_CA_CERT=

# ── Disaster domain — flood prediction & water level ─────────────────────────
# Paths to the Python flood model + interpreter. Leave empty to use defaults
# (edge-gateway .venv + edge-gateway XGBoost model).
DISASTER_PYTHON_EXECUTABLE=
DISASTER_FLOOD_MODEL_SCRIPT=
DISASTER_EDGE_GATEWAY_BASE_URL=http://localhost:5000
DISASTER_EDGE_WATER_LEVEL_HISTORY_PATH=/gauging-station-water-level-history

# ── Education domain — alert database ────────────────────────────────────────
# SQLite file used for synced PAGES alerts. Override in tests to use a temp DB.
ALERTS_DB_PATH=./data/alerts.db

# ── Resources domain — live camp data (Postgres) ─────────────────────────────
# Persists persons/distributions received from campData.service.js so they
# survive a restart, instead of living only in the in-memory store.
PGHOST=localhost
PGPORT=5432
PGDATABASE=smartcamp
PGUSER=smartcamp_app
PGPASSWORD=
