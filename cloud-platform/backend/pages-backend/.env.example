# ─── PAGES Backend — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Device / Camp Identity ────────────────────────────────────────────────────
# Each Raspberry Pi unit has a unique DEVICE_ID.
# CAMP_ID drives the child_id prefix (e.g. "CAMP-B" → prefix "B" → "B-001")
DEVICE_ID=SCB-UNIT-01
CAMP_ID=CAMP-B-HOMAGAMA

# ── Gate & Alert Thresholds ───────────────────────────────────────────────────
GATE_THRESHOLD=55
ALERT_CONSECUTIVE=3
ALERT_OF_FIVE=3

# ── ML Service (Flask, runs locally on RPi) ───────────────────────────────────
FLASK_URL=http://localhost:5001

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Change JWT_SECRET to a long random string before production deployment.
JWT_SECRET=change_this_to_a_long_random_secret_before_deployment
JWT_EXPIRES_IN=8h

# ── AWS RDS PostgreSQL (used only when internet available) ────────────────────
AWS_RDS_HOST=your-rds-instance.ap-south-1.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_DB=pages_db
AWS_RDS_USER=pages_user
AWS_RDS_PASSWORD=your_rds_password_here

# ── AWS S3 (for ML model download only) ──────────────────────────────────────
AWS_S3_BUCKET=pages-models
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# ── Sync ──────────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=2

# ── SQLite ────────────────────────────────────────────────────────────────────
# Leave as default unless you need a custom path.
SQLITE_PATH=./database/pages.db
