# ─── PAGES Backend — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Required minimum for local/offline mode:
# PORT, NODE_ENV, DEVICE_ID, CAMP_ID, JWT_SECRET
#
# Optional for cloud sync mode:
# TURSO_URL, TURSO_AUTH_TOKEN, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Device / Camp Identity ────────────────────────────────────────────────────
# Each Raspberry Pi unit has a unique DEVICE_ID.
# CAMP_ID drives the child_id prefix (e.g. "CAMP-B" → prefix "B" → "B-001")
DEVICE_ID=SCB-UNIT-01
CAMP_ID=CAMP-B-HOMAGAMA

# ── Gate & Alert Thresholds ───────────────────────────────────────────────────
GATE_THRESHOLD=55
ALERT_CONSECUTIVE=3
ALERT_OF_FIVE=3

NEXT_PUBLIC_API_URL=http://localhost:3001
REACT_APP_API_BASE_URL=http://localhost:3001

# ── ML Service (Flask, runs locally on RPi) ───────────────────────────────────
FLASK_URL=http://localhost:5001

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# REQUIRED: Change JWT_SECRET to a long random string before deployment.
JWT_SECRET=change_this_to_a_long_random_secret_before_deployment
JWT_EXPIRES_IN=8h

# ── Turso (used for cloud sync when internet is available) ───────────────────
TURSO_URL=libsql://pages-pasinduhansana.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ── Legacy AWS RDS PostgreSQL (deprecated) ────────────────────────────────────
AWS_RDS_HOST=
AWS_RDS_PORT=5432
AWS_RDS_DB=pages_db
AWS_RDS_USER=pages_user
AWS_RDS_PASSWORD=

# ── AWS S3 (for ML model download only) ──────────────────────────────────────
AWS_S3_BUCKET=pages-models
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# ── Sync ──────────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=2

# ── SQLite ────────────────────────────────────────────────────────────────────
# Leave as default unless you need a custom path.
SQLITE_PATH=./database/pages.db
