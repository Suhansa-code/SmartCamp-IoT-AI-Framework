# Cloud-hosted PAGES ML scoring service

FLASK_PORT=5001
FLASK_DEBUG=false
GATE_THRESHOLD=55
BASELINE_ALPHA=0.20
BASELINE_INIT=60.0
ZSCORE_THRESHOLD=-2.0
IF_SCORE_THRESHOLD=-0.10
ZSCORE_MIN_SESSIONS=3
IF_MIN_SESSIONS=8

# PostgreSQL source of truth
# If POSTGRES_URL is a full SQLAlchemy URL, it is used directly.
# Otherwise, POSTGRES_URL is treated as the host name.
POSTGRES_URL=localhost
POSTGRES_USER=pages_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pages_db

# SQLite fallback for local development
SQLITE_PATH=./data/pages.db

DATA_DIR=./data
MODELS_DIR=./models
