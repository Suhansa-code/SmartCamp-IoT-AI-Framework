# =============================================
# SmartCamp ML Service (PAGES scoring) — environment
# Copy to .env and fill in your values.
# =============================================

# ── HTTP server ──────────────────────────────────────────────────────────────
FLASK_PORT=5001
FLASK_DEBUG=false

# ── Scoring thresholds ────────────────────────────────────────────────────────
GATE_THRESHOLD=55
BASELINE_ALPHA=0.20
BASELINE_INIT=60.0
ZSCORE_THRESHOLD=-2.0
IF_SCORE_THRESHOLD=-0.10
IF_CONTAMINATION=0.10
ZSCORE_MIN_SESSIONS=3
IF_MIN_SESSIONS=8

# ── Database ─────────────────────────────────────────────────────────────────
# If POSTGRES_URL is a full SQLAlchemy URL it is used directly.
# Otherwise POSTGRES_URL is treated as the host name and combined with the
# credentials below. When unset, SQLite is used.
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# SQLite fallback for local development / tests
SQLITE_PATH=./data/pages.db

# ── Paths ─────────────────────────────────────────────────────────────────────
DATA_DIR=./data
MODELS_DIR=./models