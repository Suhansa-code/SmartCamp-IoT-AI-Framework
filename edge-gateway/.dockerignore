# scripts/.venv is a ~hundreds-of-MB x86 virtualenv. Shipping it into an arm64
# image is both slow to upload as build context and actively wrong — the
# interpreter and compiled wheels inside it cannot run on the Pi.
**/.venv
**/venv
**/__pycache__
**/*.py[cod]

# Generated at train time inside the image; a host copy would shadow it.
prediction-models/**/models/
prediction-models/**/artifacts/
prediction-models/comparison_results/

**/.pytest_cache
**/.mypy_cache
**/.env
**/.env.*
**/*.log
.git
.gitignore
Dockerfile
.dockerignore
README.md
**/README.md
