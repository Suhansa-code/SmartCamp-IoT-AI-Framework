# Edge Gateway (Intel NUC) — copy to .env and adjust.

# ONLY used with the docker-compose.sensors.yml overlay. The base compose
# passes no device through, so the stack comes up with no bridge attached and
# simply reports GPS/DHT11 disconnected.
#
# ESP32 Sensor_Bridge serial device. Find it with:
#   ls -l /dev/serial/by-id/    (then resolve to the /dev/ttyUSB* it points at)
# Do NOT use a /dev/serial/by-id/... path here: compose's short device syntax
# splits on ':' and those names can contain one.
GPS_SERIAL_PORT=/dev/ttyUSB1
GPS_BAUDRATE=115200

# Wireless rainfall ESP32: seconds without a POST before the sensor is
# reported disconnected.
RAINFALL_WIRELESS_TIMEOUT_SECONDS=30

# Host port. The Pi backend's EDGE_API_URL must match it.
EDGE_PORT=8000

# gid of the `dialout` group on the host — check with: getent group dialout
DIALOUT_GID=20
