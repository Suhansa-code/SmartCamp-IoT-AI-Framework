# Edge Gateway — Serial Port Configuration
# Copy to .env and adjust for your hardware.
#
# Both GPS and DHT11 are read from a single ESP32 over one USB serial connection.
# The ESP32 forwards GPS NMEA sentences and sends DHT11 as TEMP:XX|HUM:XX lines.
#
# Raspberry Pi:
#   ESP32 → /dev/ttyUSB0 (or /dev/ttyACM0)
#
# Windows (dev):
#   ESP32 → COM5

# ── ESP32 serial port (unified GPS + DHT11) ─────────
GPS_PORT=COM5
GPS_BAUDRATE=115200

# Mock fallback location (used when GPS fix unavailable)
GPS_MOCK_LATITUDE=6.9271
GPS_MOCK_LONGITUDE=79.8612
GPS_MOCK_LOCATION_NAME=Colombo

# ── Wireless Rainfall Sensor Configuration ──────────
# Rainfall ESP32 connects via Wi-Fi instead of serial
# The Edge Gateway receives data via POST /api/rainfall

# Timeout for considering rainfall sensor disconnected (seconds)
# If no data received for this duration, sensor_status = ERROR
RAINFALL_WIRELESS_TIMEOUT_SECONDS=30

# Enable/disable wireless rainfall receiver (default: true)
RAINFALL_WIRELESS_ENABLED=true
