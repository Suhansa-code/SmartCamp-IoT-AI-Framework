# Edge Gateway — Serial Port Configuration
# Copy to .env and adjust for your hardware.
#
# Raspberry Pi:
#   GPS  → /dev/ttyUSB0 (or /dev/ttyACM0)
#   DHT11/ESP32 → /dev/ttyUSB1 (or /dev/ttyACM1)
#
# Windows (dev):
#   GPS  → COM5
#   DHT11/ESP32 → COM5 (same port = contention, use separate USB adapters)

# ── GPS ──────────────────────────────────────────────
GPS_PORT=COM5
GPS_BAUDRATE=115200

# Mock fallback location (used when GPS fix unavailable)
GPS_MOCK_LATITUDE=6.9271
GPS_MOCK_LONGITUDE=79.8612
GPS_MOCK_LOCATION_NAME=Colombo

# ── DHT11 (ESP32 USB serial) ────────────────────────
# Set to None or omit to auto-detect ESP32 port
DHT11_PORT=COM5
DHT11_BAUDRATE=9600
