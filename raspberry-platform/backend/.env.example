PORT=5000
NODE_ENV=development
CAMP_ID=CAMP-B
DEVICE_ID=SCB-UNIT-01

GATE_THRESHOLD=55
FLASK_URL=http://localhost:5001

JWT_SECRET=CHANGE_THIS_SECRET
JWT_EXPIRES_IN=8h

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://192.168.4.1:3000
ALLOW_VERCEL_PREVIEWS=true

CAMP_DB_PATH=./db/camp.db
PAGES_DB_PATH=./db/pages.db

# Fingerprint scanner (ESP32 + R503 over USB serial)
# Leave FINGERPRINT_ENABLED=false on dev machines — scans then use the simulator.
FINGERPRINT_ENABLED=false
FINGERPRINT_SERIAL_PORT=/dev/ttyUSB0
FINGERPRINT_BAUD_RATE=115200
FINGERPRINT_MAX_SLOTS=200
FINGERPRINT_SIMULATE=true

# EMQX
EMQX_HOST=i17140d1.ala.asia-southeast1.emqxsl.com
EMQX_PORT=8883
EMQX_USERNAME=admin
EMQX_PASSWORD=public
EMQX_CA_CERT=./emqxsl-ca.crt
EMQX_API_KEY=
EMQX_API_SECRET=

# Cloud sync (Turso/PostgreSQL)
TURSO_URL=
TURSO_AUTH_TOKEN=

# AWS (legacy)
AWS_RDS_HOST=
