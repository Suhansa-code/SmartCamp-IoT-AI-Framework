PORT=5000
NODE_ENV=development
DEVICE_ID=SCB-UNIT-01

GATE_THRESHOLD=55
FLASK_URL=http://localhost:5001
# Native development runs Flask on localhost. Docker Compose overrides this
# with http://python-service:5001 so Express reaches the separate container.
CLOUD_ML_URL=http://localhost:5001

JWT_SECRET=CHANGE_THIS_SECRET
JWT_EXPIRES_IN=8h

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://192.168.4.1:3000
ALLOW_VERCEL_PREVIEWS=true

CAMP_DB_PATH=./db/camp.db
PAGES_DB_PATH=./db/pages.db

# Fingerprint scanner (ESP32 + R503 over USB serial)
# Leave FINGERPRINT_ENABLED=false on dev machines — scans then use the simulator.
FINGERPRINT_ENABLED=false
FINGERPRINT_SERIAL_PORT=/dev/ttyUSB1
FINGERPRINT_BAUD_RATE=115200
FINGERPRINT_MAX_SLOTS=200
FINGERPRINT_SIMULATE=true

# EMQX
EMQX_HOST=sa60a43c.ala.asia-southeast1.emqxsl.com
EMQX_PORT=8883
EMQX_USERNAME=admin
EMQX_PASSWORD=admin@123
EMQX_CA_CERT=./emqxsl-ca.crt
# EMQX Serverless does not expose the authentication/user REST API used by
# emqx-manager.js, so per-person MQTT user provisioning cannot run here. Leave
# these empty; set the Deployment API Key (App ID / App Secret) only if a
# future non-serverless deployment needs it.
EMQX_API_KEY=
EMQX_API_SECRET=

# Cloud sync (Turso/PostgreSQL)
TURSO_URL=
TURSO_AUTH_TOKEN=

# AWS (legacy)
AWS_RDS_HOST=

# Edge Gateway API URL (for sensor data)
# Default: http://127.0.0.1:8000
# For Raspberry Pi deployment, update to the Edge Gateway IP
EDGE_API_URL=http://127.0.0.1:8000

# Rainfall storage interval (minutes)
# How often to fetch and store rainfall data from Edge Gateway
RAINFALL_STORAGE_INTERVAL_MINUTES=2
