
# Multi-purpose Dockerfile for Raspberry Platform backend
# - Node 20 runtime for the Express server
# - Python3 + pip for model scripts under `python/`
# Both stages MUST stay on the same Debian release: better-sqlite3 compiles a
# native module against the builder's glibc, and a bullseye->bookworm mismatch
# makes it segfault intermittently at runtime rather than failing the build.
## Builder stage: install build deps and compile native modules
FROM node:20-bookworm AS builder

ENV NODE_ENV=production
WORKDIR /usr/src/app

# Install build dependencies required by native modules (node-gyp)
RUN apt-get update && apt-get install -y --no-install-recommends \
	python3 \
	make \
	g++ \
	build-essential \
	libsqlite3-dev \
	&& rm -rf /var/lib/apt/lists/*

# Install node dependencies (cacheable)
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev

# Copy application source
COPY . .

## Runtime stage: slim image with only runtime files
FROM node:20-bookworm-slim AS runner

ENV NODE_ENV=production
ENV PORT=5000
WORKDIR /usr/src/app

# Copy built node_modules and app from builder
COPY --from=builder /usr/src/app/node_modules ./node_modules
COPY --from=builder /usr/src/app .

# Ensure app files are readable by non-root `node` user
RUN chown -R node:node /usr/src/app
USER node

EXPOSE ${PORT}

CMD ["node", "server.js"]

