{
  "name": "smartcamp-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Unified SmartCamp backend — camp operations + PAGES education + ML scoring",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:seed-tasks": "node db/seed/tasks.js",
    "db:seed-children": "node db/seed/children.js",
    "python:start": "cd python && python app.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.3.0",
    "node-cron": "^3.0.3",
    "pg": "^8.22.0",
    "qrcode": "^1.5.3",
    "socket.io": "^4.8.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "optionalDependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "serialport": "^12.0.0"
  }
}
